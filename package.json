{
  "name": "@ivjnus/cookie-sync",
  "version": "0.10.0",
  "description": "Keep headless browsers signed in: end-to-end encrypted cookie sync from Chrome to a CLI, Playwright, curl and yt-dlp",
  "license": "MIT",
  "author": "mbcc2006",
  "type": "module",
  "files": [
    "src/",
    "skills/"
  ],
  "bin": {
    "cookie-sync": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/relay.js",
    "cli": "node src/cli.js",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "pack:extension": "node scripts/pack-extension.mjs",
    "build:site": "node scripts/build-site.mjs",
    "deploy:site": "npm run build:site && npx wrangler@4 deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbcc2006/cookie-sync.git"
  },
  "homepage": "https://cookie-sync.ivjn.us",
  "bugs": {
    "url": "https://github.com/mbcc2006/cookie-sync/issues"
  },
  "keywords": [
    "cookies",
    "cookie-sync",
    "headless",
    "playwright",
    "storageState",
    "chrome-extension",
    "e2ee",
    "end-to-end-encryption",
    "automation",
    "curl",
    "yt-dlp",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "playwright-core": "^1.55.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  }
}
