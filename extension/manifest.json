{
  "manifest_version": 3,
  "name": "CookieSync",
  "version": "0.3.0",
  "description": "Continuously encrypt and sync permitted browser cookies to a paired CookieSync CLI.",
  "permissions": ["cookies", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup.html"
  }
}
