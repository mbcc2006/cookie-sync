{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.9.1",
  "description": "__MSG_extDescription__",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://relay.ivjn.us/*"
      ],
      "js": [
        "pair-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "default_locale": "en"
}
